# Copy to `.env` for local development:  cp .env.example .env
#
# NOTE: anything prefixed with VITE_ is inlined into the JavaScript bundle and
# is therefore PUBLIC once deployed. This is acceptable here because the
# hackathon team key is already committed in `Foodsharing API/KEYS.txt`, but do
# not put a real secret in a VITE_ variable.
#
# Leave this empty and the app will ask the user to paste a key on first run
# (Settings → API key), which is stored in localStorage only.

VITE_FS_API_KEY=

# Base URL of the foodsharing hackathon API. Rarely needs changing.
VITE_FS_API_BASE=https://app-foodsharing-hackathon.azurewebsites.net

# ------------------------------------------------------------------
# Google sign-in (Firebase Authentication)
# ------------------------------------------------------------------
# Required: Google is the only sign-in method. If configuration is missing,
# sign-in remains unavailable; there is no guest or demo fallback.
#
# These five ARE public, and that is fine: a Firebase web config is an
# address, not a credential. What protects the project is the authorised
# domain list in the console plus the server verifying every ID token. See
# docs/FIREBASE.md for where to copy each value from.
#
# The server needs FIREBASE_PROJECT_ID set to the SAME project id, in
# server/.env — without it the server refuses every Google sign-in with 501.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional; only other Firebase products use them. Keeping them here lets you
# paste the console's snippet verbatim.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
