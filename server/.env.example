# ReMain server configuration.
#
# NOTHING in this file may ever move into app/.env with a VITE_ prefix:
# Vite inlines VITE_* into the JavaScript bundle, which makes it public.

PORT=8080
NODE_ENV=development

# Signs the session cookie. Any long random string; change it for deploy.
SESSION_SECRET=change-me-before-deploy

# SQLite file. Leave unset for server/data/remain.db.
# DATABASE_FILE=/var/data/remain.db

# ------------------------------------------------------------------
# Google sign-in — the project id, and nothing else.
# ------------------------------------------------------------------
# Firebase ID tokens are RS256 JWTs signed by Google with a key pair whose
# public half is published, so verifying one needs no credential of ours:
# there is NO service-account JSON in this project, nothing to leak and
# nothing to rotate. The project id is public anyway — it ships in the
# client bundle as VITE_FIREBASE_PROJECT_ID, and the two must match.
#
# Unset, every /api/session/google call is answered with 501 and the app
# shows the guest sign-in alone. Full walkthrough: docs/FIREBASE.md
# FIREBASE_PROJECT_ID=

# foodsharing Hackathon API — the one live partner interface we have.
FS_API_KEY=team_02_88829cd2c44749b796a70dfbf7dce344
FS_API_BASE=https://app-foodsharing-hackathon.azurewebsites.net
# The team key carries two test accounts. The app acts as one of them: by
# default the verified one, picked from GET /users at first use. Set an id
# here to pin a specific account instead.
# FS_USER_ID=

# Where the demo content is seeded. Set these to the hackathon room before
# the jury arrives, or they open an empty map.
VENUE_LAT=50.1109
VENUE_LON=8.6821

# Phase 4 — the scan agent. One vision provider, plus the fixtures.
#
# groq  a vision model over the free tier. The only provider that actually
#       looks at the picture.
# mock  deterministic fixtures, no network at all. The stage insurance:
#       with bad venue wifi or a rate-limited free tier the demo still runs,
#       and every answer says it came from fixtures. It does NOT look at the
#       photo — it picks a fixture by hashing the image bytes — so never demo
#       a real classification on it.
#
# Leave LLM_PROVIDER unset: the server uses groq when GROQ_API_KEY is set and
# falls back to mock when it is not. Set it to pin one.
# LLM_PROVIDER=


# https://console.groq.com/keys — never give this a VITE_ prefix.
# GROQ_API_KEY=

# Groq renames models often. Check https://console.groq.com/docs/vision
# before a demo — that page lists which ids actually take an image.
# Checked 2026-09-12: qwen/qwen3.8-27b and qwen/qwen3.6-27b.
# Leave unset for qwen/qwen3.8-27b.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# "Falsch erkannt?" corrections, appended as JSON lines.
# SCAN_CORRECTIONS_FILE=server/data/scan-corrections.jsonl

# --- Vytal Mehrweg -----------------------------------------------------
# The token belongs to ONE store and is what makes ReMain a Vytal station:
# checkouts draw on that store's stock, returns book into it. Team 02 has
# demo store B (FES_HACK_B). Paste the JWT from the Vytal Notion page here.
# Never with a VITE_ prefix — Vite inlines those into the public bundle, and
# a store credential in a public bundle is a stranger's lunch on our stock.
#
# Check the `service` claim in the payload before trusting a token: one that
# says "other" reads fine but cannot create users, which takes the whole
# Mehrweg screen down with a ServiceNameRequired. `node scripts/vytal-probe.mjs`
# prints the claim. See integrations/vytal/INTEGRATION.md.
VYTAL_JWT=
VYTAL_API_BASE=https://merchantapi.vytal.org
# Public store directory. No token; the literal header is Authorization: ANONYMOUS.
VYTAL_GRAPHQL_BASE=https://colugo.vytal.org/
# What the app calls our own station on screen.
VYTAL_STORE_NAME=ReMain-Station Frankfurt
