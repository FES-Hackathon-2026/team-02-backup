# ReMain server configuration.
#
# NOTHING in this file may ever move into app/.env with a VITE_ prefix:
# Vite inlines VITE_* into the JavaScript bundle, which makes it public.

PORT=8080
NODE_ENV=development

# Signs the session cookie. Any long random string; change it for deploy.
SESSION_SECRET=change-me-before-deploy

# SQLite file. Leave unset for server/data/remain.db.
# DATABASE_FILE=/var/data/remain.db

# ------------------------------------------------------------------
# Google sign-in — the project id, and nothing else.
# ------------------------------------------------------------------
# Firebase ID tokens are RS256 JWTs signed by Google with a key pair whose
# public half is published, so verifying one needs no credential of ours:
# there is NO service-account JSON in this project, nothing to leak and
# nothing to rotate. The project id is public anyway — it ships in the
# client bundle as VITE_FIREBASE_PROJECT_ID, and the two must match.
#
# Unset, every /api/session/google call is answered with 501 and the app
# shows the guest sign-in alone. Full walkthrough: docs/FIREBASE.md
# FIREBASE_PROJECT_ID=

# foodsharing Hackathon API — the one live partner interface we have.
FS_API_KEY=team_02_88829cd2c44749b796a70dfbf7dce344
FS_API_BASE=https://app-foodsharing-hackathon.azurewebsites.net

# Where the demo content is seeded. Set these to the hackathon room before
# the jury arrives, or they open an empty map.
VENUE_LAT=50.1109
VENUE_LON=8.6821

# Phase 4 — the scan agent.
#
# mock    deterministic fixtures, no network at all. This is the stage
#         insurance: with bad venue wifi the demo still runs, and every
#         answer says it came from fixtures. It does NOT look at the photo —
#         it picks a fixture by hashing the image bytes — so never demo a
#         real classification on it.
# claude  Claude vision. This is the one that actually looks at the picture.
# groq    a vision model over the free tier, same contract.
#
# Leave LLM_PROVIDER unset and the server picks the first provider that has
# a key, falling back to mock when none does. Set it to pin one.
# LLM_PROVIDER=

# https://console.anthropic.com/settings/keys — never give this a VITE_ prefix.
# ANTHROPIC_API_KEY=

# Leave unset for claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# --- Groq, the alternative vision provider ---
# mock  deterministic fixtures, no network at all. This is the stage
#       insurance: with bad venue wifi or a rate-limited free tier the
#       demo still runs, and every answer says it came from fixtures.
# groq  a vision model over the free tier. Falls back to the fixtures on
#       its own if the call fails, and the app shows which one answered.


# https://console.groq.com/keys — never give this a VITE_ prefix.
# GROQ_API_KEY=

# Groq renames models often. Check https://console.groq.com/docs/vision
# before a demo — that page lists which ids actually take an image.
# Checked 2026-09-12: qwen/qwen3.8-27b and qwen/qwen3.6-27b.
# Leave unset for qwen/qwen3.8-27b.
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# "Falsch erkannt?" corrections, appended as JSON lines.
# SCAN_CORRECTIONS_FILE=server/data/scan-corrections.jsonl
